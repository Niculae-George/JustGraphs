# Publish only the app's reproducible inputs, README, and screenshots.
/*
!/.gitignore
!/README.md
!/CMakeLists.txt
!/CMakePresets.json
!/build.py
!/LICENSE
!/LICENSE.*

# Handwritten CMake helpers (not generated build output).
!/cmake/
/cmake/**
!/cmake/*.cmake

# App source, tests, Qt resources, and the embedded road dataset.
!/JustGraphs/
/JustGraphs/**
!/JustGraphs/**/
!/JustGraphs/**/CMakeLists.txt
!/JustGraphs/**/*.cpp
!/JustGraphs/**/*.h
!/JustGraphs/**/*.qrc
!/JustGraphs/maps/hartaLuxembourg.xml

# Original app screenshots used by the README.
!/screenshots/
/screenshots/**
!/screenshots/*.png

# Keep generated files and local editor state out, even inside source folders.
**/build/
**/dist/
**/cmake-build-*/
**/CMakeFiles/
**/*_autogen/
**/_deps/
**/CMakeCache.txt
**/compile_commands.json
**/build.ninja
**/.ninja_*
**/cmake_install.cmake
**/CTestTestfile.cmake
**/Makefile
**/.idea/
**/.vscode/
**/__pycache__/
**/.DS_Store
*.py[cod]
*.o
*.obj
*.a
*.lib
*.dylib
*.so
*.dll
*.exe
*.app/
