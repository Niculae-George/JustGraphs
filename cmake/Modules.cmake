# Each source directory belongs to one module. CONFIGURE_DEPENDS notices additions
# and removals while keeping tests and the executable entry point out of libraries.
function(justgraphs_compile_options target)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W3 /permissive- /utf-8)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
        if(JUSTGRAPHS_SANITIZE)
            target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
            target_link_options(${target} PUBLIC -fsanitize=address,undefined)
        endif()
    endif()
endfunction()

function(justgraphs_module target)
    cmake_parse_arguments(MODULE "" "" "DIRECTORIES;LIBRARIES" ${ARGN})
    set(sources)
    foreach(directory IN LISTS MODULE_DIRECTORIES)
        file(GLOB_RECURSE discovered CONFIGURE_DEPENDS
            "${CMAKE_CURRENT_SOURCE_DIR}/${directory}/*.cpp"
            "${CMAKE_CURRENT_SOURCE_DIR}/${directory}/*.h"
            "${CMAKE_CURRENT_SOURCE_DIR}/${directory}/*.qrc")
        list(APPEND sources ${discovered})
    endforeach()
    list(FILTER sources EXCLUDE REGEX "/main\\.cpp$")
    add_library(${target} STATIC ${sources})
    target_include_directories(${target} PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}")
    target_link_libraries(${target} PUBLIC ${MODULE_LIBRARIES})
    justgraphs_compile_options(${target})
endfunction()

function(justgraphs_tests directory library)
    file(GLOB test_sources CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/tests/${directory}/*_test.cpp")
    foreach(source IN LISTS test_sources)
        get_filename_component(name "${source}" NAME_WE)
        add_executable(${name} "${source}")
        target_link_libraries(${name} PRIVATE ${library})
        if(directory MATCHES "^(rendering|features|app)$")
            target_link_libraries(${name} PRIVATE Qt6::Test)
        endif()
        justgraphs_compile_options(${name})
        if(directory STREQUAL "maps")
            add_test(NAME ${name} COMMAND ${name} "${CMAKE_CURRENT_SOURCE_DIR}/maps/hartaLuxembourg.xml")
        else()
            add_test(NAME ${name} COMMAND ${name})
        endif()
        if(directory MATCHES "^(rendering|features|app)$")
            set_tests_properties(${name} PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen")
        endif()
    endforeach()
endfunction()
