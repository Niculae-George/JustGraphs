if(NOT DEFINED SOURCE_DIR)
    message(FATAL_ERROR "SOURCE_DIR is required")
endif()

set(domain_allowed domain)
set(algorithms_allowed algorithms domain)
set(maps_allowed maps)
set(rendering_allowed rendering ui domain algorithms)
set(ui_allowed ui)
set(features_allowed features ui rendering maps algorithms domain)
set(app_allowed app features ui)

foreach(layer IN ITEMS domain algorithms maps rendering ui features app)
    file(GLOB_RECURSE sources "${SOURCE_DIR}/${layer}/*.h" "${SOURCE_DIR}/${layer}/*.cpp")
    foreach(source IN LISTS sources)
        file(READ "${source}" contents)
        if(layer MATCHES "^(domain|algorithms|maps)$" AND
           contents MATCHES "#include[ \t]*[<\"](QtWidgets|QtGui|QWidget|QPainter|QPolygon|QColor|QPixmap|QApplication)")
            message(FATAL_ERROR "UI dependency in ${layer}: ${source}")
        endif()
        string(REGEX MATCHALL "#include[ \t]*[<\"][^>\"]+[>\"]" includes "${contents}")
        foreach(include IN LISTS includes)
            string(REGEX REPLACE "#include[ \t]*[<\"]([^>\"]+)[>\"]" "\\1" dependency "${include}")
            string(REGEX REPLACE "^([^/]+)/.*" "\\1" dependency_layer "${dependency}")
            set(project_include FALSE)
            if(include MATCHES "#include[ \t]*\"")
                set(project_include TRUE)
            elseif(dependency_layer MATCHES "^(domain|algorithms|maps|rendering|ui|features|app)$")
                set(project_include TRUE)
            endif()
            if(project_include)
                if(NOT EXISTS "${SOURCE_DIR}/${dependency}")
                    message(FATAL_ERROR "Project include must resolve from source root: ${source}: ${dependency}")
                endif()
                if(NOT dependency_layer IN_LIST ${layer}_allowed)
                    message(FATAL_ERROR "Forbidden dependency ${layer} -> ${dependency_layer}: ${source}")
                endif()
            endif()
        endforeach()
    endforeach()
endforeach()
message(STATUS "Module include boundaries verified")
